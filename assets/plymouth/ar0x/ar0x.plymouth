# /home/user/ar0xOS/assets/plymouth/ar0x/ar0x.plymouth
# Target: /usr/share/plymouth/themes/ar0x/ar0x.plymouth
# -----------------------------------------------------------------------------
# PHASE 4 — Plymouth theme descriptor. ModuleName=script uses plymouth's script
# plugin (no compiled plugin needed). ImageDir/ScriptFile are absolute because
# the theme is embedded in the initramfs by the mkinitcpio `plymouth` hook.
# -----------------------------------------------------------------------------
[Plymouth Theme]
Name=ar0x
Description=ar0x 0.1.0 Neon Root boot splash
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/ar0x
ScriptFile=/usr/share/plymouth/themes/ar0x/ar0x.script
