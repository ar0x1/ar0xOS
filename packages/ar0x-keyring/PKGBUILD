# /home/user/ar0xOS/packages/ar0x-keyring/PKGBUILD
# -----------------------------------------------------------------------------
# PHASE 9 — pacman trust bootstrap for the signed [ar0x] repository.
#
# `pacman-key --populate ar0x` (see pacman-key(8) "PROVIDING A KEYRING FOR
# IMPORT") reads three files from /usr/share/pacman/keyrings:
#   ar0x.gpg       binary public keyring (dearmored from the ASCII armored key)
#   ar0x-trusted   ownertrust dump: <40-HEX-FINGERPRINT>:6:  (ultimate)
#   ar0x-revoked   one fingerprint per line (empty until a key is revoked)
# It imports the key, locally signs the trusted fingerprints and imports their
# ownertrust — which is REQUIRED because [ar0x] SigLevel=Required inherits
# TrustedOnly from the pacman.conf [options] default.
#
# ⚠️ MANUAL GATE: `ar0x-public-key.asc` is GENERATED by
#    `sudo ./tools/setup-repo.sh --keygen` on an air-gapped host. It is a
#    derived, gitignored (*.asc) artifact and its checksum is 'SKIP' until
#    keygen runs; `./tools/setup-repo.sh --sync` then replaces SKIP with the
#    real SHA-256 and regenerates ar0x-trusted from the fingerprint file.
#    NEVER commit a private key (RISK-051).
# -----------------------------------------------------------------------------
pkgname=ar0x-keyring
pkgver=0.1.0
pkgrel=1
pkgdesc="ar0x [ar0x] repository signing key + pacman trust bootstrap"
arch=('any')
url="https://github.com/ar0x1/ar0xOS"
license=('GPL-3.0-or-later')
depends=('pacman' 'gnupg')
makedepends=('gnupg')
install=ar0x-keyring.install
source=(
    'ar0x-public-key.asc'
    'ar0x-trusted'
    'ar0x-revoked'
    'ar0x-keyring.install'
    'pacman.conf.ar0x-entry'
)
sha256sums=(
    'SKIP'
    'b1ba4b7778cff45ae2eda8d3e5b0f6a10779ba7e250ea2124d046fd5e4cfa587'
    'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855'
    '59b994b6976496c0513b4d171dbee96a17821c79db53bb333f2217b2f805d2d0'
    '772b32d79f4c12aefcaf37c468a9a3bdb99f5ce1cee155383b242cdc7edaf94b'
)

package() {
    install -dm755 "$pkgdir/usr/share/pacman/keyrings"
    gpg --batch --yes --dearmor \
        -o "$pkgdir/usr/share/pacman/keyrings/ar0x.gpg" \
        "$srcdir/ar0x-public-key.asc"
    install -Dm644 "$srcdir/ar0x-trusted" "$pkgdir/usr/share/pacman/keyrings/ar0x-trusted"
    install -Dm644 "$srcdir/ar0x-revoked" "$pkgdir/usr/share/pacman/keyrings/ar0x-revoked"
    install -Dm644 "$srcdir/ar0x-keyring.install" \
        "$pkgdir/usr/share/doc/ar0x-keyring/ar0x-keyring.install"
    install -Dm644 "$srcdir/pacman.conf.ar0x-entry" \
        "$pkgdir/usr/share/doc/ar0x-keyring/pacman.conf.ar0x-entry"
}
