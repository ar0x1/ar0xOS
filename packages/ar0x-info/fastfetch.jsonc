// /usr/share/ar0x/info/fastfetch.jsonc  (DERIVED from config/branding/fastfetch/)
// ---------------------------------------------------------------------------
// Phase 7 REPLACED the Phase 6 builtin "arch" logo with the official ar0x mark.
// `"type": "file"` expands $1..$9 in ar0x-fastfetch.txt using logo.color;
// `"file-raw"` would print those placeholders literally. Verified against
// fastfetch dev src/logo/ascii/a/*.txt (builtin logos use $1..$9 exactly).
// ar0x-info OWNS its art copy so it also works on a stock Arch install where
// the Phase 7 /usr/share/ar0x/branding/ overlay is absent. The absolute path
// is intentional: /etc/skel is copied into every new home.
// ---------------------------------------------------------------------------
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/ar0x/info/ar0x-fastfetch.txt",
    "color": { "1": "cyan", "2": "magenta", "3": "green" },
    "padding": { "top": 0, "left": 1, "right": 3 },
    "position": "left"
  },
  "display": {
    "separator": "  ──  ",
    "color": { "keys": "cyan", "title": "magenta" },
    "key": { "width": 18 }
  },
  "modules": [
    { "type": "title", "key": "ar0x" },
    "os", "host", "kernel", "uptime", "packages", "shell",
    "de", "wm", "wmtheme", "terminal", "cpu", "gpu",
    "memory", "disk", "localip", "datetime",
    {
      "type": "custom",
      "format": "  {#5}ar0x 0.1.0  ──  Neon Root  ──  github.com/ar0x1/ar0xOS"
    }
  ]
}
