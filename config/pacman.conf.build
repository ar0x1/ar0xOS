# /home/user/ar0xOS/config/pacman.conf.build
# -----------------------------------------------------------------------------
# PHASE 3 — CANONICAL BUILD-ONLY pacman.conf for mkarchiso / pacstrap.
#
# ⚠️ RISK-006: THIS FILE MUST NEVER BECOME /etc/pacman.conf ON AN INSTALLED
# SYSTEM. It pins every repository to the frozen 2026/11/01 Arch archive
# snapshot; an installed system would be permanently stuck on 2026-11-01
# packages. The installed file is config/pacman.conf.installed (Phase 5/9).
#
# tools/bootstrap.sh renders this into archiso/pacman.conf, substituting
# @AR0X_REPO_DIR@ with the real local [ar0x] repo path. It also REMOVES the
# marked [ar0x] block when that repo database does not exist yet, because
# Phase 3 bootstraps only SNAPSHOT packages; Phase 11 re-adds it (ADR-017).
#
# archiso 92 notes (verified against archiso/mkarchiso::_make_pacman_conf):
#   * mkarchiso runs `pacman-conf --config <profile>/pacman.conf`, strips
#     CacheDir/DBPath/HookDir/LogFile/RootDir, then re-adds CacheDir and
#     forces HookDir to <airootfs>/etc/pacman.d/hooks/.
#   * Therefore NEVER use `Include = /etc/pacman.d/mirrorlist` here: pacman-conf
#     would expand it to the HOST's live mirrors and destroy reproducibility.
#     Only explicit `Server =` lines are used below.
# -----------------------------------------------------------------------------

[options]
Architecture = x86_64
HoldPkg      = pacman glibc
SigLevel     = Required DatabaseOptional
LocalFileSigLevel = Optional
ParallelDownloads = 5
# Non-default path => mkarchiso keeps it, so all builds share one warm cache.
CacheDir     = /opt/ar0x-build/cache/pacman/pkg

# --- BEGIN AR0X_REPO_BLOCK ---------------------------------------------------
# ADR-017: [ar0x] MUST stay FIRST. pacman resolves a package from the first
# repo that provides it, so our HARD-pinned hyprland 0.57.1 / calamares 3.4.3
# (built from exact upstream tarballs in Phases 8/9) win over [extra]'s older
# hyprland 0.57.0-3. Do NOT enable [extra-testing] as an alternative.
#
# Build-time SigLevel is intentionally relaxed: this is a local file:// repo
# whose packages were just built and SHA256-verified on this machine. The
# INSTALLED system's [ar0x] entry (config/pacman.conf.installed, Phase 9) uses
# `SigLevel = Required` with the key shipped by ar0x-keyring. See ADR-018.
[ar0x]
SigLevel = Optional TrustAll
Server = file://@AR0X_REPO_DIR@
# --- END AR0X_REPO_BLOCK -----------------------------------------------------

[core]
SigLevel = Required DatabaseOptional
Server = https://archive.archlinux.org/repos/2026/11/01/$repo/os/$arch

[extra]
SigLevel = Required DatabaseOptional
Server = https://archive.archlinux.org/repos/2026/11/01/$repo/os/$arch

# [multilib] is intentionally absent: ar0x v0.1 is x86_64-only and has no
# 32-bit payload. Enabling it would add ~1 GB to the sync DB for no benefit.
