# /home/user/ar0xOS/config/versions.env
# -----------------------------------------------------------------------------
# ar0x distribution — MACHINE-READABLE VERSION PINS (Phase 1)
# -----------------------------------------------------------------------------
# This file is SOURCED by every tools/*.sh script via tools/lib/common.sh.
# It is deliberately a plain `KEY=value` file, NOT an executable script: sourcing
# it must not run code. Shell scripts themselves always use #!/bin/bash and
# `set -euo pipefail` (see tools/validate-versions.sh for the enforcement check).
#
# All values were verified against upstream on 2026-11-03. Evidence and URLs:
#   /home/user/ar0xOS/docs/architecture/COMPONENT_VERSIONS.md
#
# PIN CLASSES
#   SNAPSHOT = resolved from the frozen Arch archive mirror (AR0X_SNAPSHOT_DATE)
#   HARD     = exact upstream tag + recorded SHA256, built from a vendored tarball
#   FLOATING = optional post-install software, never inside the ISO
# -----------------------------------------------------------------------------

# --- Distribution identity ---------------------------------------------------
AR0X_VERSION="0.1.0"
AR0X_CODENAME="Neon Root"
AR0X_ID="ar0x"
AR0X_ID_LIKE="arch"
AR0X_ARCH="x86_64"
AR0X_ISO_LABEL="AR0X_010"
AR0X_ISO_NAME="ar0x-0.1.0-x86_64.iso"
# archiso 92 install_dir: ^[a-z0-9]+$, max 30 chars (mkarchiso validation).
AR0X_INSTALL_DIR="ar0x"
AR0X_ISO_MAX_BYTES="2362232012"   # 2.2 GiB hard size gate (PROJECT_PLAN.md §7)

# --- Reproducibility ---------------------------------------------------------
# Frozen mirror used ONLY by config/pacman.conf.build (mkarchiso). The installed
# system uses config/pacman.conf.installed with live mirrors + [ar0x]. RISK-006.
AR0X_SNAPSHOT_DATE="2026/11/01"
AR0X_SNAPSHOT_ISO="2026.11.0"
AR0X_ARCHIVE_URL="https://archive.archlinux.org/repos"

# --- Base / foundation (SNAPSHOT) --------------------------------------------
AR0X_GLIBC_VERSION="2.44"
AR0X_BASH_VERSION="5.3.20"
AR0X_SYSTEMD_VERSION="262.1"
AR0X_PYTHON_VERSION="3.14.9"
AR0X_QT_VERSION="6.12"
AR0X_GTK4_VERSION="4.24.1"
AR0X_ARCHISO_VERSION="92-1"
# archiso 92 profile contract (Phase 3 profiledef.sh MUST use these keys):
AR0X_ARCHISO_BUILDMODES="iso"
AR0X_ARCHISO_BOOTMODES="bios.syslinux uefi.grub"
AR0X_ARCHISO_AIROOTFS_TYPE="squashfs"
# HARD-pinned packages (Hyprland 0.57.1, Calamares 3.4.3) are built from source
# into [ar0x] and listed BEFORE [core]/[extra] in pacman.conf.build — see ADR-017.
AR0X_HARD_PIN_REPO_PRIORITY="first"

# --- Kernel / initramfs / boot (SNAPSHOT) ------------------------------------
AR0X_KERNEL_FLAVOR="linux-lts"
AR0X_KERNEL_VERSION="6.18.59-1"
AR0X_KERNEL_PACKAGE="linux-lts=6.18.59-1"
AR0X_KERNEL_HEADERS_PACKAGE="linux-lts-headers=6.18.59-1"
AR0X_KERNEL_LTS_EOL="2027-12"
AR0X_MKINITCPIO_VERSION="42.2"
AR0X_GRUB_VERSION="2.16"
AR0X_PLYMOUTH_VERSION="26.134.222-2"
AR0X_CUSTOM_KERNEL_PATCHES="none"     # ⚠️ RISK-001: MUST stay "none" for v0.1

# --- Core system (SNAPSHOT) --------------------------------------------------
AR0X_MESA_VERSION="26.2.6"
AR0X_PIPEWIRE_VERSION="1.6.10"
AR0X_NVIDIA_DRIVER_VERSION="615.78.08"
AR0X_BTRFS_PROGS_VERSION="7.3"
AR0X_XFSPROGS_VERSION="7.2.1"
AR0X_CRYPTSETUP_VERSION="2.8.8"
AR0X_TZDATA_VERSION="2026c-1"
AR0X_DEFAULT_LOCALE="en_US.UTF-8"
AR0X_DEFAULT_TIMEZONE="UTC"
AR0X_DEFAULT_KEYMAP="us"
AR0X_DEFAULT_FS="ext4"

# --- Desktop: Hyprland ecosystem (HARD pins, matched set) -------------------
# ⚠️ Hyprland 0.57 REMOVED hyprland.conf. Lua config is MANDATORY. RISK-002.
AR0X_HYPR_CONFIG_FORMAT="lua"
AR0X_HYPR_CONFIG_ENTRY="hyprland.lua"
AR0X_HYPRLAND_VERSION="0.57.1"
AR0X_HYPRLAND_TAG="v0.57.1"
AR0X_HYPRPAPER_VERSION="0.8.5"
AR0X_HYPRLOCK_VERSION="0.9.7"
AR0X_HYPRIDLE_VERSION="0.1.8"
AR0X_XDPH_VERSION="1.5.0"          # xdg-desktop-portal-hyprland
AR0X_HYPRPICKER_VERSION="0.4.8"
AR0X_HYPRCURSOR_VERSION="0.1.13"
AR0X_WAYBAR_VERSION="0.15.0"
AR0X_SDDM_VERSION="0.21.0-7"
AR0X_DEFAULT_SHELL="zsh"
AR0X_SCRIPT_SHELL="bash"

# --- Installer (HARD pin, upstream is CODEBERG, not GitHub) -----------------
# ⚠️ github.com/calamares/calamares is an ARCHIVED MIRROR at v3.3.14. RISK-003.
AR0X_CALAMARES_VERSION="3.4.3"
AR0X_CALAMARES_TAG="v3.4.3"
AR0X_CALAMARES_SOURCE="codeberg"
AR0X_CALAMARES_URL="https://codeberg.org/Calamares/calamares/releases/download/v3.4.3/calamares-3.4.3.tar.gz"
AR0X_CALAMARES_SIG_URL="https://codeberg.org/Calamares/calamares/releases/download/v3.4.3/calamares-3.4.3.tar.gz.asc"
AR0X_CALAMARES_SHA256="144cbbf6bdcebfb21685950db4f0777218519df095f62f4aa392f28348110d18"
AR0X_CALAMARES_SIGNING_KEY="6D08 3784 1C06 8A23 3F24 127B 14B6 CC38 1BC2 56D6"
AR0X_CALAMARES_RELEASED="2026-09-10"

# --- Optional developer toolchain (FLOATING, welcome-app installs) ----------
AR0X_LLVM_VERSION="23.1.4"
AR0X_GO_VERSION="1.27.3"
AR0X_RUST_VERSION="1.99.1"
AR0X_NODE_VERSION="26.13"
AR0X_OPENJDK_VERSION="27.0.1"

# --- ar0x-authored packages (all track AR0X_VERSION) ------------------------
AR0X_PKGREL="1"
AR0X_PACKAGES="ar0x-welcome ar0x-update ar0x-info ar0x-theme ar0x-wallpapers ar0x-hypr-config ar0x-keyring ar0x-meta"

# --- Branding palette (single source of truth, ADR-015) ---------------------
AR0X_VOID="#07090F"
AR0X_SURFACE="#11151F"
AR0X_CYAN="#00E5FF"
AR0X_MAGENTA="#FF2E88"
AR0X_LIME="#A8FF60"
AR0X_TEXT="#D7E0EE"
AR0X_MUTED="#6B7891"
AR0X_ALERT="#FF5C57"

# --- Posture flags -----------------------------------------------------------
AR0X_SECURE_BOOT="optional"        # shim shipped; MOK enrollment is MANUAL
AR0X_APPARMOR_MODE="complain"      # ⚠️ enforcing breaks portals (RISK-008)
AR0X_REPRODUCIBLE="package-level"  # bit-for-bit ISO reproducibility is v0.2
AR0X_RELEASE_CADENCE="quarterly"
