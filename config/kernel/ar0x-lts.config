# /home/user/ar0xOS/config/kernel/ar0x-lts.config
# -----------------------------------------------------------------------------
# PHASE 4 — ar0x kernel requirement contract ("exact menuconfig selections").
#
# ⚠️ THIS IS AN AUDIT FRAGMENT, NOT A BUILD INPUT. ar0x uses the STOCK Arch
#    `[core] linux-lts 6.18.59-1` binary package. Nothing is compiled here and
#    NO kernel patches are applied (RISK-001 — see config/kernel/README.md).
#
# tools/build-kernel.sh parses this file and asserts every symbol against a real
# kernel config (/proc/config.gz, /boot/config-linux-lts, or --config FILE):
#   CONFIG_FOO=y  -> must be exactly =y
#   CONFIG_FOO=m  -> =y OR =m is acceptable (Arch builds most drivers as =m)
#   # CONFIG_FOO is not set -> must be unset
#
# Values asserted as =y below were VERIFIED in the actual upstream
# `config.x86_64` at packaging tag 6.18.59-1. Everything else uses =m so that
# either a built-in or a module satisfies the requirement.
#
# The COMPLETE frozen config is locked to /opt/ar0x-build/out/kernel-config.lock
# by `tools/build-kernel.sh --lock-config`.
# -----------------------------------------------------------------------------

# --- General setup -----------------------------------------------------------
# make menuconfig -> General setup
#   [*] Kernel .config support  (CONFIG_IKCONFIG)
#   [*]   Enable access to .config through /proc/config.gz
# Required so build-kernel.sh can audit the running kernel at build/test time.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

#   [*] Control Group support   -> systemd, PipeWire, resource accounting
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
#   [*] Namespaces support      -> systemd sandboxing, containers, Flatpak
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
#   [*] Auditing support        -> AppArmor audit logs
CONFIG_AUDIT=y
#   [*] Enable the bpf() system call -> systemd, bpftool, observability
CONFIG_BPF_SYSCALL=y
#   [*] Configure standard kernel features (expert users) -> sysctl hardening
CONFIG_SYSCTL=y
#   [*] Multiple users, groups and capabilities support
CONFIG_MULTIUSER=y
#   Preemption Model -> Voluntary Kernel Preemption (desktop responsiveness)
CONFIG_PREEMPT_VOLUNTARY=y
#   Timer subsystem -> Full dynticks system (tickless) — Arch default
CONFIG_NO_HZ_FULL=y

# --- Initramfs / compression -------------------------------------------------
# make menuconfig -> General setup -> Initial RAM filesystem and RAM disk support
#   [*] Support initial ramdisks compressed using ZSTD
# REQUIRED: config/mkinitcpio.conf uses COMPRESSION="zstd". Without
# CONFIG_RD_ZSTD=y the kernel cannot unpack the live initramfs -> black screen.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
# make menuconfig -> General setup -> Kernel compression mode -> ZSTD
CONFIG_KERNEL_ZSTD=y
# make menuconfig -> Enable loadable module support
CONFIG_MODULES=y

# --- Block devices / live root (archiso squashfs + overlay) ------------------
# make menuconfig -> Device Drivers -> Block devices
CONFIG_BLK_DEV_LOOP=m
# make menuconfig -> File systems -> Miscellaneous filesystems
#   [*] SquashFS 4.0 -> the airootfs.sfs live root
CONFIG_SQUASHFS=m
CONFIG_SQUASHFS_ZSTD=m
#   [*] Overlay filesystem support -> archiso's writable live overlay
CONFIG_OVERLAY_FS=m
# make menuconfig -> File systems -> CD-ROM/DVD Filesystems
CONFIG_ISO9660_FS=m
CONFIG_UDF_FS=m
# make menuconfig -> File systems -> DOS/FAT/EXFAT/NT Filesystems
CONFIG_FAT_FS=m
CONFIG_VFAT_FS=m
# make menuconfig -> File systems  (installer / user disks)
CONFIG_EXT4_FS=m
CONFIG_BTRFS_FS=m
CONFIG_XFS_FS=m
# make menuconfig -> File systems -> Native language support
CONFIG_NLS_CODEPAGE_437=m

# --- UEFI / BIOS boot --------------------------------------------------------
# make menuconfig -> Processor type and features -> EFI runtime service support
CONFIG_EFI=m
CONFIG_EFI_STUB=m
# make menuconfig -> Firmware Drivers -> EFI Variable filesystem
CONFIG_EFIVAR_FS=m
# make menuconfig -> Device Drivers -> Graphics support -> Console display driver
#   [*] VGA text console / Framebuffer Console support  (boot messages)
CONFIG_VT=m
CONFIG_VT_CONSOLE=m
CONFIG_FRAMEBUFFER_CONSOLE=m

# --- DRM / KMS / Wayland (Hyprland hard requirement) -------------------------
# make menuconfig -> Device Drivers -> Graphics support
#   <M> Direct Rendering Manager (XFree86 4.1.0 and higher DRI support)
#   <M> Simple framebuffer driver  (simpledrm: early boot splash on UEFI)
# Without early KMS, Plymouth shows a black screen and Hyprland has no outputs.
CONFIG_DRM=m
CONFIG_DRM_SIMPLEDRM=m
CONFIG_DRM_KMS_HELPER=m
# make menuconfig -> Device Drivers -> Graphics support -> Frame buffer Devices
CONFIG_FB=m

# --- Input / HID (Wayland compositor) ----------------------------------------
# make menuconfig -> Device Drivers -> Input device support
CONFIG_INPUT_EVDEV=m
# make menuconfig -> Device Drivers -> HID support
CONFIG_HID=m
CONFIG_HID_GENERIC=m
CONFIG_USB_HID=m

# --- Networking (NetworkManager, WiFi, nftables) -----------------------------
# make menuconfig -> Networking support -> Networking options
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_NETFILTER=m
#   <M> Netfilter nf_tables support  (nftables, not legacy iptables)
CONFIG_NF_TABLES=m
# make menuconfig -> Networking support -> Wireless
CONFIG_CFG80211=m
CONFIG_MAC80211=m

# --- Audio (PipeWire) --------------------------------------------------------
# make menuconfig -> Device Drivers -> Sound card support
CONFIG_SND=m
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_USB_AUDIO=m

# --- Security (AppArmor in complain mode for v0.1) ---------------------------
# make menuconfig -> Security options
CONFIG_SECURITY=m
CONFIG_SECURITY_APPARMOR=m
CONFIG_SECURITYFS=m
# NOTE: SELinux is deliberately NOT required — ar0x chose AppArmor (ADR in
# docs/architecture/DECISIONS.md). Do not add CONFIG_SECURITY_SELINUX here.

# --- Firmware / microcode ----------------------------------------------------
# make menuconfig -> Processor type and features -> CPU microcode loading support
# The mkinitcpio `microcode` hook merges intel-ucode/amd-ucode into the initramfs.
CONFIG_MICROCODE=m
CONFIG_MICROCODE_INTEL=m
CONFIG_MICROCODE_AMD=m

# --- Filesystems the installer must be able to mount -------------------------
# make menuconfig -> File systems -> Pseudo filesystems
CONFIG_DEVTMPFS=y
CONFIG_TMPFS=m
